# SnapCap - production environment template
# Copy to .env.production and fill in real values. NEVER commit the filled-in file.
#   cp .env.production.example .env.production

# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- Firebase (client config, used by the optional backend API) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Firebase Admin credentials ---
# Preferred: mount a service account key file (see docker-compose.prod.yml)
FIREBASE_SERVICE_ACCOUNT_PATH=/app/serviceAccountKey.json
# Alternative: supply the service account inline instead of a key file.
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes and be quoted.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=""

# --- Extension / CORS ---
EXTENSION_URL=
CORS_ORIGIN=

# --- Monitoring (Grafana) ---
# GRAFANA_PASSWORD is consumed by docker-compose.prod.yml as GF_SECURITY_ADMIN_PASSWORD.
GRAFANA_PASSWORD=
# Override the Grafana admin account name (defaults to "admin" in docker-compose.prod.yml).
# GF_SECURITY_ADMIN_USER=admin

# --- CI / deploy secrets (set in GitHub Actions secrets, not in this file) ---
# FIREBASE_TOKEN=
